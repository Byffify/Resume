      "css": ".ds-publish{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border-radius:6px;border:0;font:500 14px/1.5 Arial, \"Leelawadee UI\", Tahoma, sans-serif;cursor:pointer;transition:all .15s;font-size:12px;font-weight:400;background:var(--publish,#b54825);color:var(--primary-foreground,#fff);border:1px solid var(--publish,#b54825)}.ds-publish:hover{background:#ad4623}.ds-publish:focus-visible{outline:2px solid var(--ring,#426cce);outline-offset:4px}.ds-publish:disabled{opacity:.5;pointer-events:none}@media(max-width:700px),(pointer:coarse){.ds-publish{min-height:44px}}"
