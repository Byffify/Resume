      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"/about\" aria-current=\"page\">About</a><a href=\"/projects\">Projects</a><a href=\"/notes\">Notes</a><a href=\"/archive\">Archive</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:30px;font:400 14px/1.75 Arial, \"Leelawadee UI\", Tahoma, sans-serif}.ds-nav a{color:var(--foreground,#242320);text-decoration:none}.ds-nav a:hover{color:var(--link,#426cce)}.ds-nav a[aria-current]{color:#a94326}.ds-nav a:focus-visible{outline:2px solid var(--ring,#426cce);outline-offset:4px}@media(max-width:700px){.ds-nav{width:100%;justify-content:space-between;gap:10px;font-size:13px}}@media(max-width:700px),(pointer:coarse){.ds-nav a{display:inline-flex;align-items:center;min-height:44px;min-width:44px}}"
