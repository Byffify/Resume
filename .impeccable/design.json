  "components": [
    {
      "name": "Public Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Charcoal public action.",
      "html": "<button class=\"ds-primary\">About &amp; experience</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:22px;padding:11px 22px;border:1px solid var(--primary,#242320);border-radius:5px;font:400 14px/1.5 Arial, \"Leelawadee UI\", Tahoma, sans-serif;text-decoration:none;cursor:pointer;transition:background .15s;background:var(--primary,#242320);color:var(--primary-foreground,#fff)}.ds-primary:hover{background:#49453e}.ds-primary:focus-visible{outline:2px solid var(--ring,#426cce);outline-offset:4px}.ds-primary:disabled{cursor:default}"
    },
    {
      "name": "Public Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary public action.",
      "html": "<button class=\"ds-outline\">Explore notes</button>",
      "css": ".ds-outline{display:inline-flex;align-items:center;justify-content:center;gap:22px;padding:11px 22px;border:1px solid var(--primary,#242320);border-radius:5px;font:400 14px/1.5 Arial, \"Leelawadee UI\", Tahoma, sans-serif;text-decoration:none;cursor:pointer;transition:background .15s;background:transparent;color:var(--foreground,#242320)}.ds-outline:hover{background:#f2efe8}.ds-outline:focus-visible{outline:2px solid var(--ring,#426cce);outline-offset:4px}"
    },
    {
      "name": "Owner Default Button",
