      "css": ".ds-resource{display:block;min-width:0;border:1px solid #dededb;border-radius:16px;padding:18px 20px;background:var(--card,#fff);color:var(--foreground,#242320);text-decoration:none;font-family:Arial, \"Leelawadee UI\", Tahoma, sans-serif;transition:border-color .15s,background .15s}.ds-resource:hover{border-color:#9caac5;background:#fefefe}.ds-resource:focus-visible{outline:2px solid var(--ring,#426cce);outline-offset:4px}.ds-resource h3{margin:0;font-size:15px;line-height:1.6;font-weight:600;color:var(--link,#426cce)}.ds-resource p{margin:4px 0 0;font-size:14px;line-height:1.65;color:#747775}@media(max-width:700px){.ds-resource{padding:16px 18px}}"
