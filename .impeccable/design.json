      "css": ".ds-owner{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border-radius:6px;border:0;font:500 14px/1.5 Arial, \"Leelawadee UI\", Tahoma, sans-serif;cursor:pointer;transition:all .15s;background:var(--primary,#242320);color:var(--primary-foreground,#fff)}.ds-owner:hover{background:color-mix(in srgb,var(--primary,#242320) 90%,transparent)}.ds-owner:focus-visible{outline:2px solid var(--ring,#426cce);outline-offset:4px}.ds-owner:disabled{opacity:.5;pointer-events:none}"
    },
