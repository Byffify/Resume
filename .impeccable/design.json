      "css": ".ds-tag{display:inline-block;background:#f2f1ee;border:1px solid #e9e7e2;padding:3px 10px;border-radius:5px;color:#63615d;font:400 12px/1.75 Arial, \"Leelawadee UI\", Tahoma, sans-serif;text-decoration:none;overflow-wrap:anywhere}.ds-tag:hover{color:var(--link,#426cce)}.ds-tag:focus-visible{outline:2px solid var(--ring,#426cce);outline-offset:4px}@media(max-width:700px),(pointer:coarse){.ds-tag{display:inline-flex;align-items:center;min-height:44px;min-width:44px}}"
