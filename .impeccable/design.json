      "html": "<section class=\"ds-editor\"><label class=\"ds-editor-label\" for=\"ds-body\">Content</label><textarea id=\"ds-body\" class=\"ds-body\" placeholder=\"Start writing\"></textarea></section>",
      "css": ".ds-editor{min-width:0;background:#fffefb;border:1px solid #eee9e0;border-radius:11px;padding:20px;box-shadow:0 2px 15px #33251606;color:var(--foreground,#242320)}.ds-editor-label{display:block;margin-bottom:6px;font:500 13px/1.75 Arial, \"Leelawadee UI\", Tahoma, sans-serif}.ds-body{width:100%;min-height:380px;resize:vertical;padding:20px;background:#fff;border:1px solid #ded9d0;border-radius:6px;color:var(--foreground,#242320);font:400 16px/1.9 Georgia,\"Leelawadee UI\",serif}.ds-body::placeholder{color:var(--muted-foreground,#6d685f)}.ds-body:focus-visible{outline:2px solid var(--ring,#426cce);outline-offset:-2px}@media(max-width:700px){.ds-editor{padding:14px}.ds-body{padding:15px;min-height:320px}}"
    }
